# Credenciales de Snowflake (copiar este archivo a .env y completar los valores reales)
SNOWFLAKE_ACCOUNT=TU_ORG-TU_CUENTA
SNOWFLAKE_USER=TU_USUARIO
SNOWFLAKE_PASSWORD=TU_PASSWORD
SNOWFLAKE_ROLE=ROL_DATAFINANCE
SNOWFLAKE_WAREHOUSE=WH_DATAFINANCE
SNOWFLAKE_DATABASE=DATAFINANCE
SNOWFLAKE_SCHEMA=BRONZE

# Groq LLM externo (para analista en lenguaje natural con openai/gpt-oss-120b)
GROQ_API_KEY=TU_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# API local de Airflow (para disparar reportes desde la interfaz)
AIRFLOW_API_URL=http://localhost:8082/api/v1
AIRFLOW_API_USER=airflow
AIRFLOW_API_PASSWORD=airflow
